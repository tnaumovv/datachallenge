{
  "name": "cqa-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write shared server web qa scripts .github vitest.config.ts",
    "format:check": "prettier --check shared server web qa scripts .github vitest.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "demo:web": "tsx web/demo.ts",
    "smoke": "node scripts/smoke.mjs",
    "qa:benchmark": "tsx qa/gemini/benchmark-run.ts",
    "export:results": "tsx server/src/results/cli.ts",
    "qa:prompt-ab": "tsx qa/gemini/prompt-ab.ts",
    "qa:prompt-report": "tsx qa/gemini/prompt-report.ts",
    "qa:provider-ab": "tsx qa/gemini/provider-ab.ts",
    "qa:openai-smoke": "tsx qa/gemini/openai-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@radix-ui/react-select": "^2.4.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "4.1.12"
  }
}
