{
  "name": "cqa-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write shared server web",
    "format:check": "prettier --check shared server web",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.0",
    "prettier": "3.9.10",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "4.1.12"
  }
}
