PORT=3000
HOST=127.0.0.1
DATABASE_PATH=runtime/cqa.sqlite
# Полная ссылка GET DEV из PDF, включая существующие query-параметры.
ORGANIZER_API_URL=

# none = импорт/чтение доступны, запуск AI-оценки возвращает 503.
AI_PROVIDER=none
# Для Gemini: AI_PROVIDER=gemini, ключ и доступный model ID из AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_MAX_OUTPUT_TOKENS=8192
# Необязательно; задавайте только для модели с поддержкой thinkingLevel.
# Пустое значение сохраняет стандартные настройки провайдера.
GEMINI_THINKING_LEVEL=
# Тайм-аут одного вызова в миллисекундах: целое число от 1 до 600000.
AI_REQUEST_TIMEOUT_MS=90000

# Альтернативы: выберите ровно один AI_PROVIDER, существующий Gemini не заменяется автоматически.
# Groq: аккаунт Free; доступность и квоту проверьте в консоли.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama: только локальный HTTP-сервер и локальная модель, без API-платы.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
# Платные альтернативы: не включайте при бюджете «только бесплатно».
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Необязательно для совместимых OpenAI/Groq моделей с поддержкой reasoning_effort.
AI_REASONING_EFFORT=
