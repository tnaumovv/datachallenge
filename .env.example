PORT=3000
HOST=127.0.0.1
DATABASE_PATH=runtime/cqa.sqlite
# Полная ссылка GET DEV из PDF, включая существующие query-параметры.
ORGANIZER_API_URL=

# none = импорт/чтение доступны, запуск AI-оценки возвращает 503.
AI_PROVIDER=none
# Для Gemini задайте AI_PROVIDER=gemini и укажите свой ключ из AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_MAX_OUTPUT_TOKENS=8192
# Профиль DEV: Flash-Lite с low. При выборе другой модели проверьте поддержку thinkingLevel.
GEMINI_THINKING_LEVEL=low
# Тайм-аут одного вызова в миллисекундах: целое число от 1 до 600000.
AI_REQUEST_TIMEOUT_MS=120000

# Альтернативы: выберите ровно один AI_PROVIDER, существующий Gemini не заменяется автоматически.
# Groq: аккаунт Free; доступность и квоту проверьте в консоли.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama: только локальный HTTP-сервер и локальная модель, без API-платы.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b
# Платные альтернативы: не включайте при бюджете «только бесплатно».
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Необязательно для совместимых OpenAI/Groq моделей с поддержкой reasoning_effort.
AI_REASONING_EFFORT=

# Opt-in candidate; v4 remains the default until a measured quality gate passes.
AI_EVALUATION_POLICY=v4
AI_EVALUATION_DEADLINE_MS=120000
AI_VERIFIER_PROVIDER=none
AI_VERIFIER_MODEL=
AI_VERIFIER_REASONING_EFFORT=
# Optional explicit standard tariff snapshot. Unknown/missing tariff is not free.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
AI_THINKING_USD_PER_MILLION=
# For OpenAI high-volume candidate trials: AI_REASONING_EFFORT=none

# Approved examples remain disabled unless explicitly enabled.
AI_USE_PRECEDENTS=false
