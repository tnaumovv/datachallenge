{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "@/*": ["./web/src/*"]
    }
  },
  "include": ["shared/**/*.ts", "server/**/*.ts"]
}
